# aiHealth Imaging — environment variable NAMES only. Never commit values.
# Copy to .env.local for local dev; set the same names on Vercel.

# ── Browser build (Vite). `vite build` fails without the two Supabase vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Canonical public viewer origin for share links and og:url (no trailing
# slash). Production builds refuse to mint share links when unset.
VITE_PUBLIC_VIEWER_URL=
# Opt-ins, default OFF. Only the exact value "true" enables them.
# Outside (third-party) AI read buttons for radiograph / CBCT.
VITE_ENABLE_THIRD_PARTY_AI=
# Live co-viewing rooms. Keep off until M1 (private Realtime channel + RLS).
VITE_ENABLE_VIEWER_ROOMS=

# ── Vercel api/* functions. Server-side names only (no VITE_ fallbacks);
# a function answers 503 when its required names are missing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# imaging-share-resolve only. Server secret — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# ai-infer only.
AI_INFERENCE_URL=
INFERENCE_INTERNAL_KEY=
# Optional CORS allowlist, comma-separated exact origins. Unset → the
# production viewer and the staff EMR origin.
ALLOWED_ORIGINS=

# ── Supabase edge function ai-read-radiograph (set as function secrets).
# Outside AI is refused (403) unless this is exactly "true".
ALLOW_CROSS_BORDER_AI=
# Legacy kill switch; "true" refuses even when ALLOW_CROSS_BORDER_AI=true.
DISABLE_CROSS_BORDER_AI=
